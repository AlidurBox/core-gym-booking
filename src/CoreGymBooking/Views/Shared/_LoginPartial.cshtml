    {
        @if (User.IsInRole(CoreGymBooking.Data.IdentitySeed.AdminRole))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Administrera pass</a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Profile" asp-action="Index">Min profil</a>
        </li>
        <li class="nav-item">
            <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Logga ut</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
